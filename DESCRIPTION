Package: threshtuner
Title: Interactive Threshold Tuning for Raster Data
Version: 0.1.0
Authors@R: 
    person("Sina", "Pohlabeln", email = "sina.pohlabeln@gmail.com", role = c("aut", "cre"))
Description: Provides Shiny-based tools for interactively tuning thresholds for terra raster data.
    Includes utilities for spectral index calculation, standard deviation and percentile thresholding, mask generation,
    histogram inspection, and RGB mask overlays.
License: MIT + file LICENSE
Encoding: UTF-8
Roxygen: list(markdown = TRUE)
RoxygenNote: 7.3.3
Imports:
    terra,
    shiny,
    ggplot2,
    bslib,
    colourpicker
